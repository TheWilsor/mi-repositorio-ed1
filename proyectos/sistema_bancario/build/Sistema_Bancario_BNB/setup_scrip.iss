; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=Sistema de Atención de Tickets BNB
AppVersion=1.0.0
AppPublisher=Wilson Leonel Mojica Cuellar
AppPublisherURL=https://uagrm.edu.bo
LicenseFile=LICENSE.txt
DefaultDirName={autopf}\Sistema Bancario BNB
DefaultGroupName=Sistema Bancario BNB
UninstallDisplayIcon={app}\Sistema_Bancario_BNB.exe
Compression=lzma2/ultra64
SolidCompression=yes
OutputDir=Output
OutputBaseFilename=Sistema_Bancario_BNB_Setup_v1.0

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "dist\Sistema_Bancario_BNB.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "LICENSE.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\Sistema Bancario BNB"; Filename: "{app}\Sistema_Bancario_BNB.exe"
Name: "{group}\{cm:UninstallProgram,Sistema Bancario BNB}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\Sistema Bancario BNB"; Filename: "{app}\Sistema_Bancario_BNB.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Sistema_Bancario_BNB.exe"; Description: "{cm:LaunchProgram,Sistema Bancario BNB}"; Flags: nowait postinstall skipifsilent